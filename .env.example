# URL de conexão do MongoDB
MONGO_DB=mongodb+srv://usuario:senha@cluster.exemplo.mongodb.net/organ

# Segredo usado para assinar o JWT (o mesmo do frontend)
JWT_SECRET=troque-por-um-segredo-forte
JWT_EXPIRES_IN=8h

PORT=4000
# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:3000
